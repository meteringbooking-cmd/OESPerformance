// LOCAL EMULATOR RULES ONLY.
// These are intentionally permissive so the Firestore Emulator has something
// to load. They are NOT the production security rules for oesperformance-a54c0
// (this repo has never contained those) and must never be deployed with
// `firebase deploy` against a real project.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
